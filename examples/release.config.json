{
  "$schema": "./node_modules/@souravojha/git-release-cli/schemas/release-config.schema.json",
  "release": {
    "baseBranch": "dev",
    "productionBranch": "main",
    "branchPrefix": "release",
    "branchTimestampFormat": "YYYYMMDD-HHmmss",
    "productionMergeStyle": "merge"
  },
  "pullRequest": {
    "title": "Release: {date}",
    "draft": false,
    "labels": [
      "release"
    ],
    "reviewers": [],
    "assignees": [],
    "includeCommitAuthors": false
  },
  "git": {
    "remote": "origin",
    "fetchBeforeRelease": true,
    "requireCleanWorkingTree": true
  },
  "changelog": {
    "includeMerges": false
  },
  "options": {
    "dryRun": true,
    "pushBranch": true,
    "createPullRequest": true
  }
}
