#!/usr/bin/env node
// Fake GitHub CLI for tests. Logs every invocation to $GH_FAKE_LOG (JSON lines).
import { appendFileSync, readFileSync } from 'node:fs';

const args = process.argv.slice(2);
const entry = { args };
const bodyIdx = args.indexOf('--body-file');
if (bodyIdx !== -1) entry.body = readFileSync(args[bodyIdx + 1], 'utf8');
if (process.env.GH_FAKE_LOG) appendFileSync(process.env.GH_FAKE_LOG, `${JSON.stringify(entry)}\n`);

const [a, b] = args;
if (a === '--version') console.log('gh version 0.0.0-fake');
else if (a === 'auth' && b === 'status') {
  if (process.env.GH_FAKE_AUTH === 'fail') { console.error('You are not logged in'); process.exit(1); }
} else if (a === 'repo' && b === 'view') console.log('acme/widgets');
else if (a === 'pr' && b === 'list') console.log(process.env.GH_FAKE_PR_LIST || '[]');
else if (a === 'pr' && b === 'create') {
  if (process.env.GH_FAKE_CREATE === 'fail') { console.error("could not add label: 'release' not found"); process.exit(1); }
  console.log('https://github.com/acme/widgets/pull/42');
} else { console.error(`fake gh: unsupported ${args.join(' ')}`); process.exit(1); }
